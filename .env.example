# Supabase Connection Settings (Public)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cheque reminder secrets are SERVER-SIDE ONLY and must never be prefixed with
# VITE_ or shipped to the browser. Set them as Supabase Edge Function secrets:
#   supabase secrets set CHEQUE_CRON_SECRET=... RESEND_API_KEY=... \
#     FROM_EMAIL=onboarding@resend.dev RESEND_TEST_RECIPIENT=<resend-account-email>
# FROM_EMAIL defaults to Resend's permitted testing sender (onboarding@resend.dev).
# While you have no verified domain, RESEND_TEST_RECIPIENT (the email registered
# with your Resend account) forces all test mail to that address only. Switch to
# your own verified sender later by setting FROM_EMAIL and removing RESEND_TEST_RECIPIENT.
# The shared secret is also stored in Supabase Vault as `cheque_cron_secret`
# (see supabase/migrations/20261101000001_cheque_reminders_cron.sql).

